{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-slider-smoke/types/**/*.ts",
    ".next-slider-smoke/dev/types/**/*.ts",
    ".next-eldora-verify/types/**/*.ts",
    ".next-eldora-verify/dev/types/**/*.ts",
    ".next-agent-rollout/types/**/*.ts",
    ".next-agent-rollout/dev/types/**/*.ts",
    ".next-agent-smoke/types/**/*.ts",
    ".next-agent-smoke/dev/types/**/*.ts",
    ".next-agent-webpack/types/**/*.ts",
    ".next-agent-webpack/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
